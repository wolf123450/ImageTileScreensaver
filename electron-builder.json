{
  "appId": "com.imagetile.screensaver",
  "productName": "Image Tile Screensaver",
  "directories": {
    "output": "build"
  },
  "files": [
    "dist/**/*",
    "package.json",
    "index.html",
    "assets/**/*"
  ],
  "win": {
    "target": "nsis",
    "icon": "assets/icon.ico",
    "signingHashAlgorithms": null,
    "signAndEditExecutable": false
  },
  "forceCodeSigning": false
}