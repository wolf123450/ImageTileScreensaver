{
  "appId": "com.example.imagetilescreensaver",
  "productName": "Image Tile Screensaver",
  "files": [
    "dist/**/*",
    "assets/**/*"
  ],
  "directories": {
    "output": "build"
  },
  "win": {
    "target": "nsis",
    "icon": "assets/icons/icon.ico"
  },
  "nsis": {
    "oneClick": true,
    "perMachine": true,
    "allowToChangeInstallationDirectory": false
  },
  "mac": {
    "target": "dmg",
    "icon": "assets/icons/icon.icns"
  },
  "linux": {
    "target": "AppImage",
    "icon": "assets/icons/icon.png"
  },
  "build": {
    "appId": "com.example.imagetilescreensaver",
    "productName": "Image Tile Screensaver",
    "files": [
      "dist/**/*",
      "assets/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icons/icon.ico"
    },
    "mac": {
      "target": "dmg",
      "icon": "assets/icons/icon.icns"
    },
    "linux": {
      "target": "AppImage",
      "icon": "assets/icons/icon.png"
    }
  }
}