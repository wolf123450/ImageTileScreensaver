{
  "appId": "com.imagetile.screensaver",
  "productName": "Image Tile Screensaver",
  "directories": {
    "output": "build"
  },
  "files": [
    "dist/**/*",
    "package.json",
    "dist/index.html",
    "assets/**/*"
  ],
  "win": {
    "target": "nsis",
    "icon": "assets/icon.ico",
    "signingHashAlgorithms": null,
    "signAndEditExecutable": false
  },
  "forceCodeSigning": false,
  "asar": true,
  "compression": "maximum",
  "removePackageScripts": true,
  "extraResources": [],
  "extraFiles": []
}