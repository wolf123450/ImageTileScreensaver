{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ImageTileScreensaver",
  "version": "../package.json",
  "identifier": "com.imagetile.screensaver",
  "build": {
    "frontendDist": "../dist",
    "beforeDevCommand": "npx webpack --mode=development --env tauri",
    "beforeBuildCommand": "npx webpack --mode=production --env tauri"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: https://asset.localhost; style-src 'self' 'unsafe-inline'",
      "assetProtocol": {
        "enable": true,
        "scope": {
          "allow": ["**"]
        }
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {}
}
