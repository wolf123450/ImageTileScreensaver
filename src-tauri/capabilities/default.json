{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default permissions for Image Tile Screensaver",
  "windows": [
    "main",
    "config",
    "screensaver-*"
  ],
  "permissions": [
    "core:default",
    "core:window:default",
    "core:window:allow-create",
    "core:window:allow-close",
    "core:window:allow-set-fullscreen",
    "core:window:allow-show",
    "core:window:allow-hide",
    "dialog:default",
    "dialog:allow-open"
  ]
}
