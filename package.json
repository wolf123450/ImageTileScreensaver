{
  "name": "image-tile-screensaver",
  "version": "0.1.0",
  "description": "A screensaver that tiles images across multiple displays",
  "productName": "Image Tile Screensaver",
  "main": "dist/main.js",
  "scripts": {
    "start": "npm run build && electron .",
    "build": "webpack --mode=development",
    "build:prod": "webpack --mode=production",
    "copy-assets": "copyfiles -u 1 \"src/configui/*.html\" \"src/configui/*.css\" dist/",
    "watch": "concurrently \"tsc -w\" \"webpack --watch\"",
    "lint": "eslint -c .eslintrc --ext .ts ./src",
    "dist": "npm run build && electron-builder --config electron-builder.json",
    "predist": "npm install --omit=dev",
    "postdist": "npm install",
    "prebuild:screensaver": "npm install --production=false",
    "build:screensaver": "node scripts/build-screensaver.js",
    "postbuild:screensaver": "npm install",
    "postinstall": "electron-builder install-app-deps"
  },
  "entrypoints": {
    "main": "dist/main.js",
    "preload": "dist/preload.js"
  },
  "author": "",
  "license": "MIT",
  "dependencies": {
    "dotenv": "^16.5.0",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "concurrently": "^8.2.1",
    "copy-webpack-plugin": "^11.0.0",
    "copyfiles": "^2.4.1",
    "css-loader": "^6.8.1",
    "dotenv": "^16.5.0",
    "electron": "^26.0.0",
    "electron-builder": "^24.6.3",
    "rimraf": "^5.0.10",
    "style-loader": "^3.3.3",
    "terser-webpack-plugin": "^5.3.14",
    "ts-loader": "^9.4.4",
    "typescript": "^5.1.6",
    "webpack": "^5.88.2",
    "webpack-cli": "^5.1.4"
  },
  "electronVersion": "26.0.0"
}
