{
  "name": "image-tile-screensaver",
  "version": "0.1.0",
  "description": "A screensaver that tiles images across multiple displays",
  "productName": "Image Tile Screensaver",
  "private": true,
  "scripts": {
    "build": "webpack --mode=development",
    "build:prod": "webpack --mode=production",
    "clean": "rimraf dist",
    "watch": "webpack --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run build && playwright test",
    "test:e2e:headed": "npm run build && playwright test --headed",
    "tauri:dev": "cargo tauri dev",
    "tauri:dev:config": "cargo tauri dev -- -- /c",
    "tauri:build": "cargo tauri build"
  },
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@tauri-apps/api": "^2.10.1",
    "@tauri-apps/plugin-dialog": "^2.7.0"
  },
  "devDependencies": {
    "@playwright/mcp": "^0.0.68",
    "@playwright/test": "^1.59.1",
    "copy-webpack-plugin": "^14.0.0",
    "css-loader": "^6.8.1",
    "http-server": "^14.1.1",
    "jsdom": "^26.1.0",
    "rimraf": "^5.0.10",
    "style-loader": "^3.3.3",
    "terser-webpack-plugin": "^5.3.14",
    "ts-loader": "^9.4.4",
    "typescript": "^5.1.6",
    "vitest": "^3.1.1",
    "webpack": "^5.88.2",
    "webpack-cli": "^5.1.4"
  }
}
